# Copiar como bridge.conf en el VPS y completar remote_password.
# El fichero real contiene secretos y está ignorado por Git.
connection pihomeblk-1
address 100.120.246.118:1883
remote_username mqtt_user
remote_password CHANGE_ME
start_type automatic
cleansession true
try_private false
notifications true
notifications_local_only true

# Estado del bridge en un topic estable y fuera de $SYS. Sin esto, Mosquitto lo
# publica en $SYS/broker/connection/<clientid>/state, y el backend se suscribe
# a `#`, que NO incluye $SYS: el enlace con la Raspberry sería justo el único
# tramo invisible. notifications_local_only lo mantiene en el broker del VPS
# (describe nuestro extremo, y viajar por el enlace es imposible precisamente
# cuando importa). Payload retenido `1` (arriba) / `0` (abajo).
notification_topic /ZRO/bridge/state

# zro-pi publica zro/... desde septiembre de 2026. El bridge traduce
# el prefijo remoto zro/ al prefijo local /ZRO/ que consume ha-web.
# Solo se replica telemetría normalizada desde la Raspberry al VPS.
topic env/# in 1 /ZRO/ zro/

# Last will retenida del servicio zro-pi (`online` / `offline`). Cubre el caso
# que la notificación anterior no ve: bridge arriba pero el servicio de la Pi
# muerto. QoS 1 porque con QoS 0 el bridge no conserva el flag de retenido y el
# estado solo se conocería tras la siguiente transición.
topic pi/availability in 1 /ZRO/ zro/
