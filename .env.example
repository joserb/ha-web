# Copiar como .env en el VPS (/opt/projects/ha-web/.env) y rellenar.
# El fichero real contiene secretos y está ignorado por Git.

# --- Red -------------------------------------------------------------------
# IP de Tailscale del VPS. Mosquitto y Nginx se publican SOLO en localhost y en
# esta IP: nada queda expuesto a internet. Obligatoria (compose falla si falta)
# para que nadie arranque el stack a medias sin darse cuenta.
TS_BIND_IP=100.120.178.39

# --- MQTT ------------------------------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=haweb
MQTT_PASSWORD=

# Topics en los que el navegador puede publicar a través del WebSocket, en una
# lista separada por comas. VACÍA por defecto: mientras no haya panel de
# actuadores, ningún cliente puede publicar nada. No admite comodines.
# Ej: WS_PUBLISH_ALLOWLIST=home/salon/luz/set,home/estudio/luz/set
WS_PUBLISH_ALLOWLIST=

# --- InfluxDB --------------------------------------------------------------
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=haweb
INFLUXDB_BUCKET=sensors
INFLUXDB_USER=
INFLUXDB_PASSWORD=

# --- Sensores --------------------------------------------------------------
# Antigüedad (segundos) a partir de la cual una lectura se marca obsoleta en el
# dashboard. 3600 por defecto; subirlo solo si algún dispositivo real reporta
# más despacio que eso.
SENSOR_STALE_AFTER_SECONDS=3600

# --- Vigilante del stack (scripts/stack-watchdog.sh) -----------------------
# Opcionales: sin ellos el vigilante sigue funcionando, solo que sin avisar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Avisos temporales de puerta --------------------------------------------
# Comparten TELEGRAM_BOT_TOKEN y TELEGRAM_CHAT_ID con el vigilante.
NOTIFICATION_TIMEZONE=Europe/Madrid
# Opcional: orígenes exactos separados por comas si se usan otros nombres DNS.
# Por defecto se permiten http://{TS_BIND_IP,localhost,127.0.0.1,charo-vps}:8080.
# NOTIFICATION_ALLOWED_ORIGINS=http://100.120.178.39:8080,http://charo-vps:8080

# --- Cámara doméstica --------------------------------------------------------
# Interruptor de despliegue del visor. `false` oculta la tarjeta y deja la ruta
# de vídeo sin destino: es el estado correcto mientras la pasarela de la
# Raspberry no esté desplegada y verificada.
CAMERA_ENABLED=false
# IP Tailscale de pihomeblk-1 y puerto de go2rtc. Debe coincidir con
# GATEWAY_BIND_IP del `.env` de camera-gateway/ en la Pi.
# CAMERA_GATEWAY_HOSTPORT=100.x.y.z:1984
